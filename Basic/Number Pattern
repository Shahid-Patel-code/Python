# Number Patterns
# 1 1 1
# 2 2 2
# 3 3 3
n = 3
# 1st way
for i in range(1, n+1):
    print((str(i) + " ") * n)

# 2nd way
for i in range(1, n+1):
    for j in range(n):
        print(i, end=" ")
    print()

