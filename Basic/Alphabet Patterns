# Alphabet Patterns
# A A A
# B B B
# C C C
n = 3
# 1st way
for i in range(n):
    print((chr(65 + i) + " ") * n)
# 2nd way
for i in range(n):
    for j in range(n):
        print(chr(65 + i), end=" ")
    print()

