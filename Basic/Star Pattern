# Square Star Pattern
# * * * *
# * * * *
# * * * *
# * * * *
n = 4
for i in range(n):
    for j in range(n):
        print("*", end=" ")
    print()

# Right half Triangle (Increasing)
# *
# * *
# * * *
# * * * *
n = 4
# 1st way
for i in range(1, n+1):
    print("* " * i)

# 2nd way
for i in range(1, n+1):
    for j in range(i):
        print("*", end=" ")
    print()

#Inverted Right half Triangle (Decreasing)
# * * * *
# * * *
# * *
# *
n = 4
# 1st way
for i in range(n, 0, -1):
    print("* " * i)
# 2nd way
for i in range(n, 0, -1):
    for j in range(i):
        print("*", end=" ")
    print()

# Left half Triangle (Increasing)
#    *
#   ** 
#  ***
# ****
n = 4
for i in range(1, n+1):
    for k in range(n-i):
        print(" ", end="")
    for j in range(i):
        print("*", end="")
    print()

# Inverted Left half Triangle (Decreasing)
# ****
#  ***  
#   **
#    *
n = 4
for i in range(n, 0, -1):
    for k in range(n-i):
        print(" ", end="")
    for j in range(i):
        print("*", end="")
    print()

# pyramid pattern
#    *
#   *** 
#  *****
# *******
n = 4
for i in range(1, n+1):
    for k in range(n-i):
        print(" ", end="")
    for j in range(2*i-1):
        print("*", end="")
    print()

# Inverted pyramid pattern
# *******
#  *****    
#   ***
#    *
n = 4
for i in range(n, 0, -1):
    for k in range(n-i):
        print(" ", end="")
    for j in range(2*i-1):
        print("*", end="")
    print()

# Diamond pattern
#    *  
#   ***
#  *****
# *******   
#  *****
#   ***
#    *
n = 4
# upper half
for i in range(1, n+1):
    for k in range(n-i):
        print(" ", end="")
    for j in range(2*i-1):
        print("*", end="")
    print()
# lower half
for i in range(n-1, 0, -1):
    for k in range(n-i):
        print(" ", end="")
    for j in range(2*i-1):
        print("*", end="")
    print()

# equliateral triangle pattern
#    *
#   * *
#  * * *
# * * * *   
n = 4
for i in range(1, n+1):
    for k in range(n-i):
        print(" ", end="")
    for j in range(i):
        print("* ", end="")
    print()

# print Letter L
# *
# *
# *
# *
# * * * * *
n = 5
for i in range(1, n+1):
    if i < n:
        print("*")
    else:
        print("* " * n)

# print Letter T
# * * * * *
#     * 
#     *
#     *
#     *
n = 5
for i in range(1, n+1):
    if i == 1:
        print("* " * n)
    else:
        print("  " * (n//2) + "*")
